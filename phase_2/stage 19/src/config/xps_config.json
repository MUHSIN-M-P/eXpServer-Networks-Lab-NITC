{
	"server_name": "eXpServer",
	"servers": [
		{
			"listeners": [{ "host": "0.0.0.0", "port": 8001 }],
			"routes": [
				{
					"req_path": "/",
					"type": "file_serve",
					"dir_path": "../public/",
					"index": ["sample.txt"],
					"gzip_enable": true,
					"gzip_mime_types": ["text/plain"],
					"gzip_level": 8
				
				},
				{
					"req_path": "/index",
					"type": "file_serve",
					"dir_path": "../public/",
					"index": ["index.html"]
				},
				{
					"req_path": "/gzip",
					"type": "file_serve",
					"file_path": "../public/",
					"index": ["sample.pdf"],
					"gzip_enable": true,
					"gzip_level": 8,
					"gzip_mime_types": ["text/x-c"]
				},
				{
					"req_path": "/redirect",
					"type": "redirect",
					"http_status_code": 302,
					"redirect_url": "http://localhost:8002/"
				}
			]
		},
		{
			"listeners": [{ "host": "0.0.0.0", "port": 8002 }],
			"routes": [
				{
					"req_path": "/",
					"type": "reverse_proxy",
					"upstreams": ["localhost:3000"]
				}
			]
		},
		{
			"listeners": [{ "host": "0.0.0.0", "port": 8003 }],
			"routes": [
				{
					"req_path": "/",
					"type": "redirect",
					"http_status_code": 302,
					"redirect_url": "https://expserver.github.io"
				}
			]
		}
	]
}
